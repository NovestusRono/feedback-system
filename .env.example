# Frontend (public, safe to commit): put these in js/supabase-client.js config.
# The anon key is public by design; Row Level Security protects the data.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# NEVER put the service role key in the frontend or in GitHub.
# It is only set as an Edge Function secret (Milestone 3):
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...   (done in the Supabase dashboard/CLI)
